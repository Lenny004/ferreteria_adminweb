# URL pública del backend; debe permitir CORS con credenciales desde http://localhost:3000.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# En el backend: CORS_ORIGIN=http://localhost:3000
# En producción: COOKIE_SAMESITE=lax (same-site) o none junto con COOKIE_SECURE=true
# y COOKIE_DOMAIN si se comparte entre subdominios.
